{
    "name": "hetao29/slightphp",
    "version": "6.0",
    "description": "SlightPHP PHP FrameWork",
    "keywords": [
        "php",
        "framework",
        "slightphp"
    ],
    "homepage": "https://github.com/hetao29/slightphp",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "ext-PDO": "*",
        "ext-redis": "*",
        "gregwar/captcha": "^1.3 || ^2.0",
        "guzzlehttp/guzzle": "^7.0 || ^8.0"
    },
    "authors": [
        {
            "name": "hetao",
            "email": "hetao@hetao.name",
            "homepage": "https://github.com/hetao29"
        }
    ],
    "autoload": {
        "files": [
            "SlightPHP.php",
            "plugins/tpl/Tpl.function.php",
            "plugins/tpl/Tpl.modifier.php"
        ],
        "psr-4": {
            "SlightPHP\\": "plugins/"
        }
    }
}

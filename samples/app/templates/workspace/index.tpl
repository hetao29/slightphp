<div class="eyebrow">YOUR FIRST APPLICATION</div><h1>{SampleI18n::t('turn_an_idea_into_your_next_step')}</h1><p class="lead">{SampleI18n::t('explore_slightphp_requests_and_responses_with_a_small_complete')}</p>
<div class="stats"><article><span>{SampleI18n::t('all_tasks')}</span><strong>{count($tasks)}</strong></article><article><span>{SampleI18n::t('to_do')}</span><strong>{count($tasks) - $done}</strong></article><article><span>{SampleI18n::t('progress')}</span><strong>{count($tasks) ? round($done / count($tasks) * 100) : 0}<small>%</small></strong></article></div>
{if ($flash)}<div class="notice" role="status">{$flash}</div>{/if}
<section class="panel"><div class="section-head"><div><h2>{SampleI18n::t('my_tasks')}</h2><p>{SampleI18n::t('every_small_step_is_worth_recording')}</p></div><a href="/workspace/main/api" target="_blank" rel="noopener">{SampleI18n::t('view_json')}</a></div>
<form class="add-form" method="post" action="/workspace/main/save"><input type="hidden" name="_csrf" value="{$csrf}"><input type="hidden" name="action" value="add"><label class="sr-only" for="title">{SampleI18n::t('new_task_name')}</label><input id="title" name="title" maxlength="80" required placeholder="{SampleI18n::t('what_would_you_like_to_do_next')}" autocomplete="off"><button class="primary">{SampleI18n::t('add_task')}</button></form>
<div class="filters" aria-label="{SampleI18n::t('filter_tasks')}"><button type="button" data-filter="all" aria-pressed="true">{SampleI18n::t('all')}</button><button type="button" data-filter="todo" aria-pressed="false">{SampleI18n::t('to_do_56')}</button><button type="button" data-filter="done" aria-pressed="false">{SampleI18n::t('done')}</button><label class="sr-only" for="search">{SampleI18n::t('search_tasks')}</label><input id="search" type="search" placeholder="{SampleI18n::t('search_tasks_59')}"></div>
<div id="task-list">{foreach ($tasks as $task)}<article class="task {$task['done'] ? 'completed' : ''}" data-done="{$task['done'] ? '1' : '0'}"><form method="post" action="/workspace/main/save"><input type="hidden" name="_csrf" value="{$csrf}"><input type="hidden" name="id" value="{$task['id']}"><button class="check" name="action" value="toggle" aria-label="{($task['done'] ? SampleI18n::t('mark_as_to_do') : SampleI18n::t('complete')) . $task['title']}">{$task['done'] ? '✓' : '○'}</button><span class="task-title">{$task['title']}</span><span class="tag">{$task['done'] ? SampleI18n::t('done') : SampleI18n::t('in_progress')}</span><button class="delete" name="action" value="delete" aria-label="{SampleI18n::t('delete_392') . $task['title']}">{SampleI18n::t('delete')}</button></form></article>{/foreach}</div><p id="empty" class="empty" {if $tasks}hidden{/if}>{SampleI18n::t('no_tasks_here_add_a_task_or_try_another')}</p><p id="filter-status" class="sr-only" role="status"></p></section>
<section class="callout"><div><h3>{SampleI18n::t('what_did_the_framework_do_with_that_click')}</h3><p>{SampleI18n::t('form_post_workspace_maincontroller_save_validation_and_session_storage')}</p></div><a href="/lab/route/entry">{SampleI18n::t('explore_routing')}</a></section>

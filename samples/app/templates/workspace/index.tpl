<div class="eyebrow">YOUR FIRST APPLICATION</div><h1>{%SampleI18n::e('turn_an_idea_into_your_next_step')%}</h1><p class="lead">{%SampleI18n::e('explore_slightphp_requests_and_responses_with_a_small_complete')%}</p>
<div class="stats"><article><span>{%SampleI18n::e('all_tasks')%}</span><strong>{%count($tasks)%}</strong></article><article><span>{%SampleI18n::e('to_do')%}</span><strong>{%count($tasks) - $done%}</strong></article><article><span>{%SampleI18n::e('progress')%}</span><strong>{%count($tasks) ? round($done / count($tasks) * 100) : 0%}<small>%</small></strong></article></div>
{%if ($flash)%}<div class="notice" role="status">{%htmlspecialchars($flash, ENT_QUOTES + ENT_SUBSTITUTE, 'UTF-8')%}</div>{%/if%}
<section class="panel"><div class="section-head"><div><h2>{%SampleI18n::e('my_tasks')%}</h2><p>{%SampleI18n::e('every_small_step_is_worth_recording')%}</p></div><a href="/workspace/main/api" target="_blank" rel="noopener">{%SampleI18n::e('view_json')%}</a></div>
<form class="add-form" method="post" action="/workspace/main/save"><input type="hidden" name="csrf" value="{%$csrf%}"><input type="hidden" name="action" value="add"><label class="sr-only" for="title">{%SampleI18n::e('new_task_name')%}</label><input id="title" name="title" maxlength="80" required placeholder="{%SampleI18n::e('what_would_you_like_to_do_next')%}" autocomplete="off"><button class="primary">{%SampleI18n::e('add_task')%}</button></form>
<div class="filters" aria-label="{%SampleI18n::e('filter_tasks')%}"><button type="button" data-filter="all" aria-pressed="true">{%SampleI18n::e('all')%}</button><button type="button" data-filter="todo" aria-pressed="false">{%SampleI18n::e('to_do_56')%}</button><button type="button" data-filter="done" aria-pressed="false">{%SampleI18n::e('done')%}</button><label class="sr-only" for="search">{%SampleI18n::e('search_tasks')%}</label><input id="search" type="search" placeholder="{%SampleI18n::e('search_tasks_59')%}"></div>
<div id="task-list">{%foreach ($tasks as $task)%}<article class="task {%$task['done'] ? 'completed' : ''%}" data-done="{%$task['done'] ? '1' : '0'%}"><form method="post" action="/workspace/main/save"><input type="hidden" name="csrf" value="{%$csrf%}"><input type="hidden" name="id" value="{%htmlspecialchars($task['id'], ENT_QUOTES + ENT_SUBSTITUTE, 'UTF-8')%}"><button class="check" name="action" value="toggle" aria-label="{%htmlspecialchars(($task['done'] ? SampleI18n::t('mark_as_to_do') : SampleI18n::t('complete')) . $task['title'], ENT_QUOTES + ENT_SUBSTITUTE, 'UTF-8')%}">{%$task['done'] ? '✓' : '○'%}</button><span class="task-title">{%htmlspecialchars($task['title'], ENT_QUOTES + ENT_SUBSTITUTE, 'UTF-8')%}</span><span class="tag">{%$task['done'] ? SampleI18n::t('done') : SampleI18n::t('in_progress')%}</span><button class="delete" name="action" value="delete" aria-label="{%htmlspecialchars(SampleI18n::t('delete_392') . $task['title'], ENT_QUOTES + ENT_SUBSTITUTE, 'UTF-8')%}">{%SampleI18n::e('delete')%}</button></form></article>{%/foreach%}</div><p id="empty" class="empty" {%$tasks ? 'hidden' : ''%}>{%SampleI18n::e('no_tasks_here_add_a_task_or_try_another')%}</p><p id="filter-status" class="sr-only" role="status"></p></section>
<section class="callout"><div><h3>{%SampleI18n::e('what_did_the_framework_do_with_that_click')%}</h3><p>{%SampleI18n::e('form_post_workspace_maincontroller_save_validation_and_session_storage')%}</p></div><a href="/lab/route/entry">{%SampleI18n::e('explore_routing')%}</a></section>
